# Copy to .env (never commit .env). All optional.
EXTRACTOR=text            # claude | text | fixture  (auto-falls back to fixture for known samples)
ANTHROPIC_API_KEY=        # only needed for EXTRACTOR=claude (API credit is separate from Claude Pro)
LLM_MODEL=claude-opus-5-5 # verify the model id in current Anthropic docs
LLM_EFFORT=medium         # low | medium | high
VYAPAARIQ_DB=             # default backend/data/vyapaariq.db
